# Copie ce fichier en .env et remplis les valeurs. Ne pousse JAMAIS le .env sur GitHub.

# Token du bot (Discord Developer Portal > ton appli > Bot > Reset Token)
DISCORD_TOKEN=

# Clé The Odds API (gratuite : https://the-odds-api.com, 500 crédits/mois)
ODDS_API_KEY=

# Salon où le bot poste les alertes (clic droit sur le salon > Copier l'identifiant)
ALERT_CHANNEL_ID=

# Optionnel : ID de ton serveur pour que les commandes / apparaissent tout de suite
GUILD_ID=

# Championnats suivis (liste avec la commande /sports)
SPORTS=soccer_france_ligue_one,soccer_epl

# Bookmakers suivis + bookmaker de référence pour la cote juste
BOOKMAKERS=winamax_fr,unibet_fr,pmu_fr,betsson
REFERENCE_BOOKMAKER=pinnacle

# Marchés : h2h (1N2), totals (plus/moins). Chaque marché = 1 crédit par championnat et par scan.
MARKETS=h2h

# Fréquence du scan auto. 2 championnats toutes les 4 h ≈ 360 crédits/mois.
SCAN_INTERVAL_MINUTES=240

# Seuils d'alerte en %
MIN_SUREBET_PROFIT=0.5
MIN_VALUE_EDGE=3
MAX_VALUE_ODDS=10

# Le scan auto s'arrête quand il reste ce nombre de crédits
MIN_CREDITS_RESERVE=20
